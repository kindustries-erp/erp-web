# Sao chép file này thành .env rồi điền giá trị thực:
#   cp .env.example .env

# ── Ứng dụng ──────────────────────────────────────────────
# Tên hiển thị của ứng dụng (tuỳ chọn)
VITE_APP_NAME=Hệ thống ERP

# URL backend API (để trống nếu dùng mock data)
VITE_API_BASE_URL=https://api.example.com

# ── Môi trường ────────────────────────────────────────────
# development | production
VITE_APP_ENV=production
