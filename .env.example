# Sao chép file này thành .env rồi điền giá trị thực:
#   cp .env.example .env

# ── Ứng dụng ──────────────────────────────────────────────
# Tên hiển thị của ứng dụng (tuỳ chọn)
VITE_APP_NAME=Hệ thống ERP

# URL backend API (để trống nếu dùng mock data)
VITE_API_BASE_URL=https://api.example.com

# ── Cổng Dev Server (Frontend Port) ───────────────────────
# Khi clone repo ra nhiều bản (multi-instance), đổi port này để chạy đồng thời không bị trùng
PORT=5173

# ── Môi trường ────────────────────────────────────────────
# development | production
APP_ENV=production

# Tùy chọn (chỉ build dev): mật khẩu cho nút đăng nhập nhanh admin trên localhost
# VITE_DEV_ADMIN_PASSWORD=
