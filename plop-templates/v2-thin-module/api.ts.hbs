import { v2HttpClient } from "@/v2/shared/api/v2HttpClient";
import type {
  V2FetchOptionsParams,
  V2TableQuery,
} from "@/v2/shared/types/v2-table";
import type {
  {{apiType}},
  {{recordType}},
  {{formValueType}},
} from "{{coreBarrel}}";

const BASE = "/api/v1/{{moduleName}}";
const OPTIONS_PAGE_SIZE = 20;

/** Chuyển trạng thái bảng sang tham số truy vấn của API (giữ đúng hợp đồng server) */
const toListParams = (query: V2TableQuery) => ({
  page: query.page,
  pageSize: query.pageSize,
  search: query.search?.trim() || undefined,
  sort: query.sorts.length
    ? query.sorts
        .map((sort) =>
          sort.direction === "desc" ? `-${sort.columnKey}` : sort.columnKey,
        )
        .join(",")
    : undefined,
  column_filters: Object.keys(query.columnFilters).length
    ? JSON.stringify(query.columnFilters)
    : undefined,
  column_search: Object.keys(query.columnSearch).length
    ? JSON.stringify(query.columnSearch)
    : undefined,
  column_operators: Object.keys(query.columnOperators).length
    ? JSON.stringify(query.columnOperators)
    : undefined,
  date_ranges: Object.keys(query.dateRanges).length
    ? JSON.stringify(query.dateRanges)
    : undefined,
});

/** API của module {{moduleName}}, đúng hợp đồng {{apiType}} của lõi {{family}} */
export const {{moduleCamel}}Api: {{apiType}} = {
  list: async (query) => {
    const { data } = await v2HttpClient.get(BASE, {
      params: toListParams(query),
    });
    return data;
  },
  options: async (params: V2FetchOptionsParams) => {
    const { data } = await v2HttpClient.get(`${BASE}/column-options`, {
      params: {
        column: params.columnKey,
        search: params.search,
        page: params.pageParam,
        pageSize: OPTIONS_PAGE_SIZE,
        filters: params.filtersStr,
      },
    });
    return data;
  },
  get: async (id) => {
    const { data } = await v2HttpClient.get<{{recordType}}>(`${BASE}/${id}`);
    return data;
  },
  create: async (form: {{formValueType}}) => {
    const { data } = await v2HttpClient.post<{{recordType}}>(BASE, form);
    return data;
  },
  update: async (id: string, form: {{formValueType}}) => {
    const { data } = await v2HttpClient.patch<{{recordType}}>(
      `${BASE}/${id}`,
      form,
    );
    return data;
  },
  remove: async (id: string) => {
    const { data } = await v2HttpClient.delete<{{recordType}}>(`${BASE}/${id}`);
    return data;
  },{{{apiExtraMembers}}}
};
