import * as React from "react";
import { FileText } from "lucide-react";
import { V2Button, V2ConfirmModal, V2ModulePage } from "@/v2/shared/components";
import type { V2ModuleTab } from "@/v2/shared/components";
import {
  {{query}},
  {{drawer}},
} from "{{coreBarrel}}";
import type { {{recordType}} } from "{{coreBarrel}}";
import {
  v2ColumnPreferencesStorage,
  v2ViewPresetStorage,
} from "@/v2/shared/preferences/v2TablePreferenceStorages";
import { {{moduleCamel}}Config } from "../{{moduleCamel}}.config";
import { {{hookName}} } from "./{{pageName}}.hook";
import "../{{moduleCamel}}.locale";

/** Màn {{titleVi}}: bố cục và nối lõi; dữ liệu và thao tác lấy từ hook của lõi */
export function {{pageName}}() {
  const state = {{hookName}}();
  const { t } = state;

  const tabs = React.useMemo<V2ModuleTab<{{recordType}}>[]>(
    () => [
      {
        key: "list",
        label: t("v2.{{localeNamespace}}.list", "Danh sách"),
        kind: "list",
        resetKey: `${state.tableId}-${state.tableKey}`,
        table: {
          tableId: state.tableId,
          columns: state.columns,
          getRowKey: (row) => row.id,
          mode: "server",
          fetchOptions: (params) => {{moduleCamel}}Config.api.options(params),
          rowActions: state.rowActions,
          preferencesStorage: v2ColumnPreferencesStorage,
          viewPresetStorage: v2ViewPresetStorage,
          emptyLabel: t("v2.{{localeNamespace}}.empty", "Chưa có dữ liệu"),
          toolbar: {
            search: {},
            filterPanel: {},
            enableFullscreen: true,
            viewModes: {
              items: [
                { key: "overview", label: t("v2.common.overview", "Tổng quan") },
                { key: "all", label: t("v2.common.allColumns", "Tất cả cột") },
              ],
              activeKey: state.view,
              onSelect: state.selectView,
            },
          },
        },
        useData: (query) =>
          {{query}}({
            api: {{moduleCamel}}Config.api,
            keys: {{moduleCamel}}Config.keys,
            query,
            onError: state.onListError,
          }),
      },
    ],
    [state, t],
  );

  return (
    <V2ModulePage<{{recordType}}>
      title={t("v2.{{localeNamespace}}.title", "{{titleVi}}")}
      description={t("v2.{{localeNamespace}}.description", "{{titleVi}}")}
      icon={<FileText className="h-4 w-4" />}
      tabs={tabs}
      actions={
        state.canCreate ? (
          <V2Button size="sm" onClick={() => state.open(null, "edit")}>
            {t("v2.{{localeNamespace}}.create", "Thêm {{titleVi}}")}
          </V2Button>
        ) : undefined
      }
      overlays={
        <>
          {state.drawer && (
            <{{drawer}}
              key={`${state.drawer.id ?? "new"}-${state.drawer.mode}`}
              config={ {{moduleCamel}}Config }
              open
              recordId={state.drawer.id}
              mode={state.drawer.mode}
              canUpdate={state.canUpdate}
              onClose={() => state.setDrawer(null)}
            />
          )}
          <V2ConfirmModal
            open={Boolean(state.deleteTarget)}
            title={t("v2.{{localeNamespace}}.deleteTitle", "Xác nhận xóa")}
            message={t("v2.{{localeNamespace}}.deleteMessage", "Bạn có chắc muốn xóa?")}
            confirmLabel={t("v2.{{localeNamespace}}.deleteLabel", "Xóa")}
            cancelLabel={t("v2.common.cancel", "Hủy")}
            variant="danger"
            isLoading={state.remove.isPending}
            onConfirm={() => {
              if (state.deleteTarget) state.remove.mutate(state.deleteTarget.id);
            }}
            onCancel={() => state.setDeleteTarget(null)}
            onOpenChange={(open) => !open && state.setDeleteTarget(null)}
          />
        </>
      }
    />
  );
}
