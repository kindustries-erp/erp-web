import { render, screen } from "@testing-library/react";
import { describe, expect, it, vi } from "vitest";
import { empty{{Entity}}Form } from "../../../domain/entities/{{entity}}";
import { {{Entity}}FormSections } from "./{{Entity}}FormSections";

const renderSections = (viewing: boolean) =>
  render(
    <{{Entity}}FormSections
      form={ { ...empty{{Entity}}Form(), {{#each requiredFields}}{{name}}: "Mẫu", {{/each}} } }
      viewing={viewing}
{{#if hasNextCode}}
      codeEditable
      onRegenerateCode={vi.fn()}
{{/if}}
      errorField={null}
      errorMessage=""
      t={(_key, fallback) => fallback ?? ""}
      setField={vi.fn()}
    />,
  );

describe("{{Entity}}FormSections", () => {
  it("renders read-only values in view mode without inputs", () => {
    renderSections(true);
    expect(screen.getAllByText("Mẫu").length).toBeGreaterThan(0);
    expect(screen.queryByRole("textbox")).not.toBeInTheDocument();
  });

  it("renders editable fields in edit mode", () => {
    renderSections(false);
    expect(screen.getAllByRole("textbox").length).toBeGreaterThan(0);
  });
});
