import type { V2TableQuery } from "@/v2/shared/types/v2-table";

/**
 * Khóa React Query của họ {{family}}. `base` do module truyền vào để giữ khóa cache riêng của module.
 */
export const {{keysFactory}} = (base: readonly string[]) => {
  const all = base;
  return {
    all,
    list: (query: V2TableQuery) => [...all, "list", query] as const,
    detail: (id: string) => [...all, "detail", id] as const,
  };
};

export type {{keysType}} = ReturnType<typeof {{keysFactory}}>;
